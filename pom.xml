<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.tedredington</groupId>
    <artifactId>jazzclub</artifactId>
    <version>${revision}</version>
    <name>jazzclub</name>
    <description>Console client for Pandora, a Java port of pianobar</description>

    <properties>
        <java.version>25</java.version>
        <revision>0.1.0-SNAPSHOT</revision>
        <jline.version>4.4.5</jline.version>
        <picocli.version>4.7.7</picocli.version>
        <jacoco.version>0.8.15</jacoco.version>
        <!-- minimum line coverage enforced by `mvn verify` -->
        <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
        <!-- filled in by JaCoCo; defined so surefire's argLine still resolves with -Djacoco.skip -->
        <argLine/>
    </properties>

    <dependencies>
        <!-- Core starter only: no web server, keeps the native binary small -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient + Jackson, without any web server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal</artifactId>
            <version>${jline.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jni</artifactId>
            <version>${jline.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>jazzclub</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- generates the GraalVM reflection config for the picocli command at compile time -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}-picocli</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties, read by "jazzclub -V" -->
                    <execution>
                        <id>build-info</id>
                        <goals><goal>build-info</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- bash/zsh completion, generated from the picocli model so it cannot drift from the options -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-completion</id>
                        <phase>package</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>picocli.AutoComplete</mainClass>
                            <classpathScope>compile</classpathScope>
                            <systemProperties>
                                <!-- without this a failure only prints a usage text and the build stays green -->
                                <systemProperty>
                                    <key>picocli.autocomplete.systemExitOnError</key>
                                    <value>true</value>
                                </systemProperty>
                            </systemProperties>
                            <arguments>
                                <argument>--force</argument>
                                <argument>--completionScript</argument>
                                <!-- straight into target/: picocli does not create missing directories -->
                                <argument>${project.build.directory}/jazzclub_completion</argument>
                                <argument>com.tedredington.jazzclub.cli.JazzclubCommand</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- same as above, for "java -jar" -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      The JDK reads this switch once per JVM; main() sets it before anything else (see
                      HttpClientFactory.allowProxyCredentialsForHttps). Tests do not go through main().
                    -->
                    <argLine>@{argLine} -Djdk.http.auth.tunneling.disabledSchemes=</argLine>
                    <systemPropertyVariables>
                        <!-- tests must never read the developer's real ~/.config/jazzclub/config -->
                        <jazzclub.config-file>${project.build.directory}/no-such-config</jazzclub.config-file>
                        <jazzclub.state-file>${project.build.directory}/no-such-state</jazzclub.state-file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- thin adapters over hardware and OS: a real sound card, a real tty, a real ffmpeg -->
                        <exclude>com/tedredington/jazzclub/player/javasound/**</exclude>
                        <exclude>com/tedredington/jazzclub/player/ffmpeg/FfmpegDecoder*</exclude>
                        <exclude>com/tedredington/jazzclub/terminal/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <configuration>
                    <imageName>jazzclub</imageName>
                    <buildArgs>
                        <!-- optimise for size rather than peak throughput -->
                        <buildArg>-Os</buildArg>
                        <!-- run shutdown hooks on Ctrl-C / SIGTERM so the terminal is always restored -->
                        <buildArg>--install-exit-handlers</buildArg>
                        <!-- JLine loads its JNI library; declare that intent instead of getting a warning -->
                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                        <!-- see HttpClientFactory.allowProxyCredentialsForHttps: may be read at build time -->
                        <buildArg>-Djdk.http.auth.tunneling.disabledSchemes=</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- merges with the "native" profile of spring-boot-starter-parent -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <!--
                              native-image does not link the JNI half of Java Sound. Embed the building
                              JDK's libjsound; JavaSoundNativeSupport unpacks and loads it at runtime.
                              It is OpenJDK code under GPLv2 with the Classpath Exception, see NOTICE.
                            -->
                            <execution>
                                <id>embed-libjsound</id>
                                <phase>process-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/native-libs</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${java.home}/lib</directory>
                                            <includes>
                                                <include>libjsound.dylib</include>
                                                <include>libjsound.so</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
