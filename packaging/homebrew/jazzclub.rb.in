# Generated by scripts/render-formula.sh from packaging/homebrew/jazzclub.rb.in in
# https://github.com/tedtedted/jazzclub; edit the template there, not this file.
class Jazzclub < Formula
  desc "Console client for Pandora internet radio, a port of pianobar"
  homepage "https://github.com/tedtedted/jazzclub"
  url "@URL@"
  version "@VERSION@"
  sha256 "@SHA256@"
  # jazzclub is MIT; the decoder library bundles LavaPlayer (Apache 2.0), mpg123 (LGPL 2.1), Opus,
  # Ogg, Vorbis and libsamplerate (BSD) and the Fraunhofer FDK AAC codec, which has no SPDX id
  license all_of: ["MIT", "Apache-2.0", "LGPL-2.1-only", "BSD-3-Clause", "BSD-2-Clause", :cannot_represent]

  # The release ships a native binary for Apple Silicon only; there is nothing to compile here.
  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "bin/jazzclub"
    # jazzclub looks for its decoder library in libexec/jazzclub beside the bin it runs from,
    # following the link from HOMEBREW_PREFIX/bin into this keg (see LavaplayerNatives)
    (libexec/"jazzclub").install "libexec/jazzclub/libconnector.dylib"
    bash_completion.install "share/bash-completion/completions/jazzclub"
    doc.install "share/doc/jazzclub/README.md"
    (share/"licenses/jazzclub").install Dir["share/licenses/jazzclub/*"]
  end

  def caveats
    <<~EOS
      jazzclub decodes Pandora's audio itself. ffmpeg is only needed for decoder = ffmpeg,
      a sample_rate other than 44100, or as a fallback:
        brew install ffmpeg

      Set up your Pandora account in ~/.config/jazzclub/config; see
        #{doc}/README.md
    EOS
  end

  test do
    assert_equal "jazzclub #{version}", shell_output("#{bin}/jazzclub --version").strip
    output = shell_output("#{bin}/jazzclub --config #{testpath}/none 2>&1 </dev/null", 1)
    assert_match "No Pandora account configured", output
  end
end
